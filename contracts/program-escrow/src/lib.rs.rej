+    /// Distribute collected fees across multiple treasury destinations
+    fn distribute_fees(
+        env: &Env,
+        amount: i128,
+        destinations: Vec<TreasuryDestination>,
+        token_address: &Address,
+    ) {
+        if amount <= 0 || destinations.len() == 0 {
+            return;
+        }
+
+        let mut total_weight: u32 = 0;
+        for dest in destinations.iter() {
+            total_weight += dest.weight;
+        }
+
+        if total_weight == 0 {
+            return;
+        }
+
+        let token_client = token::Client::new(env, token_address);
+        let contract_address = env.current_contract_address();
+        let timestamp = env.ledger().timestamp();
+        let mut remaining_fee = amount;
+
+        for i in 0..destinations.len() {
+            let dest = destinations.get(i).unwrap();
+            let share = if i == destinations.len() - 1 {
+                // Last destination gets the remainder to avoid rounding issues
+                remaining_fee
+            } else {
+                amount
+                    .checked_mul(dest.weight as i128)
+                    .and_then(|x| x.checked_div(total_weight as i128))
+                    .unwrap_or(0)
+            };
+
+            if share > 0 {
+                token_client.transfer(&contract_address, &dest.destination, &share);
+                env.events().publish(
+                    (symbol_short!("dist"),),
+                    DistributionEvent {
+                        destination: dest.destination,
+                        amount: share,
+                        timestamp,
+                    },
+                );
+                remaining_fee -= share;
+            }
+        }
+    }
