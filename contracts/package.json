{
  "name": "grainlify-contracts",
  "version": "1.0.0",
  "description": "Grainlify smart contracts with machine-readable metadata manifests",
  "main": "index.js",
  "scripts": {
    "validate-manifests": "node scripts/validate-manifests.js",
    "test:manifests": "node --test scripts/test/validate-manifests.test.js",
    "generate-docs": "node scripts/generate-docs.js",
    "build": "npm run validate-manifests && npm run generate-docs",
    "test": "npm run validate-manifests && npm run test:manifests && npm run check-error-codes && npm run test:error-codes",
    "check-error-codes": "node scripts/check-error-codes.mjs",
    "test:error-codes": "node --test scripts/test/error-codes.test.js"
  },
  "devDependencies": {
    "ajv-cli": "^5.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1"
  },
  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "blockchain",
    "escrow",
    "grants",
    "metadata"
  ],
  "author": "Grainlify Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grainlify/grainlify"
  },
  "bugs": {
    "url": "https://github.com/grainlify/grainlify/issues"
  },
  "homepage": "https://grainlify.dev"
}
